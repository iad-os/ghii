{
  "name": "@ghii/ghii-v2",
  "version": "0.0.4",
  "description": "A Funny configuration manager",
  "maintainers": [
    {
      "name": "Daniele Fiungo",
      "email": "daniele.fiungo@iad2.it"
    },
    {
      "name": "Nicola Vurchio",
      "email": "nicola.vurchio@iad2.it"
    },
    {
      "name": "Irene La Bollita",
      "email": "irene.labollita@iad2.it"
    }
  ],
  "author": "Daniele Fiungo <daniele.fiungo@iad2.it>",
  "type": "module",
  "main": "build/lib/ghii.js",
  "types": "build/types/ghii.d.ts",
  "files": ["build/**"],
  "keywords": ["node", "config"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iad-os/ghii.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">= 22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "biome check --write --no-errors-on-unmatched --json-formatter-enabled=true",
    "format": "biome format --write --no-errors-on-unmatched --json-formatter-enabled=true",
    "prebuild": "rimraf build",
    "build": "tsc",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.4",
    "@tsconfig/node22": "^22.0.2",
    "@tsconfig/strictest": "^2.0.5",
    "@types/node": "^22.17.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "lefthook": "^1.12.2",
    "rimraf": "^6.0.1",
    "type-fest": "^4.41.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "zod": "^4.0.15"
  },
  "dependencies": {
    "es-toolkit": "^1.39.8"
  }
}
