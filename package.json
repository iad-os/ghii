{
  "name": "@ghii/ghii-v2",
  "version": "0.0.6",
  "description": "A Funny configuration manager",
  "maintainers": [
    {
      "name": "Daniele Fiungo",
      "email": "daniele.fiungo@iad2.it"
    },
    {
      "name": "Nicola Vurchio",
      "email": "nicola.vurchio@iad2.it"
    },
    {
      "name": "Irene La Bollita",
      "email": "irene.labollita@iad2.it"
    }
  ],
  "author": "Daniele Fiungo <daniele.fiungo@iad2.it>",
  "type": "module",
  "main": "build/lib/ghii.js",
  "types": "build/types/ghii.d.ts",
  "files": ["build/**"],
  "keywords": ["node", "config"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iad-os/ghii.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">= 24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "biome check --write --no-errors-on-unmatched --json-formatter-enabled=true",
    "format": "biome format --write --no-errors-on-unmatched --json-formatter-enabled=true",
    "prebuild": "rimraf build",
    "build": "tsc",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@tsconfig/node24": "^24.0.1",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "lefthook": "^2.1.10",
    "rimraf": "^6.1.3",
    "type-fest": "^5.8.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "es-toolkit": "^1.49.0"
  }
}
